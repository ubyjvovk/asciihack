{
  "name": "asciihack",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Play NetHack in the terminal (or over ssh) rendered as an ASCII first-person or ortho view.",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "start": "tsx src/cli.ts",
    "check": "bash scripts/check.sh",
    "web:dev": "vite --config web/vite.config.ts",
    "web:build": "vite build --config web/vite.config.ts",
    "web:server": "tsx server/ws-server.ts"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "vite": "^6.4.3",
    "@types/three": "^0.185.4",
    "@types/ws": "^8.5.13"
  },
  "dependencies": {
    "three": "^0.185.1",
    "ws": "^8.18.0"
  }
}
